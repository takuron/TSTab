{
	"name": "tstab",
	"version": "1.0.0",
	"private": true,
	"description": "一个基于 SvelteKit + Tailwind CSS v4 + DaisyUI 5 的简洁新标签页浏览器扩展",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/patch-manifest.mjs",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node tests/regressions.test.mjs",
		"test:browser": "node tests/browser-smoke.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.4",
		"@types/chrome": "^0.0.304",
		"@types/node": "^22.13.0",
		"daisyui": "^5.0.0",
		"svelte": "^5.22.6",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.0",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"svelte-i18n": "^4.0.1"
	}
}
